{
	auto_https {$AUTO_HTTPS:off}
	admin off
	servers {
		trusted_proxies static private_ranges
	}
	log {
		output stdout
		format json
	}
}

{$SITE_ADDRESS::8080} {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@backend path /api /api/* /auth /auth/* /health
	handle @backend {
		reverse_proxy {$API_URL:http://127.0.0.1:3100} {
			header_up Host {upstream_hostport}
			flush_interval -1
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
			transport http {
				dial_timeout 3s
			}
		}
	}

	handle /version.json {
		root * {$WEB_ROOT:dist}
		header Cache-Control "no-store"
		file_server
	}

	handle /assets/* {
		root * {$WEB_ROOT:dist}
		header >Cache-Control "public, max-age=31536000, immutable" {
			match status 2xx
		}
		file_server
	}

	handle {
		root * {$WEB_ROOT:dist}
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
